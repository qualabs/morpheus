ngx_addon_name=ngx_http_morpheus_module
MORPHEUS_SRCS="                                               \
              $ngx_addon_dir/ngx_http_morpheus_module.cpp     \
              $ngx_addon_dir/ngx_morpheus_internal.cpp        \
              "

if test -n "$ngx_module_link"; then
  ngx_module_type=HTTP
  ngx_module_name=ngx_http_morpheus_module
  ngx_module_srcs="$MORPHEUS_SRCS"
  . auto/module
else
  HTTP_MODULES="$HTTP_MODULES ngx_http_morpheus_module"
  NGX_ADDON_SRCS="$NGX_ADDON_SRCS $MORPHEUS_SRCS"
fi
